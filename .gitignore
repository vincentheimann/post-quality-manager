# Python caches left by the BMad scripts (`uv run _bmad/...`)
__pycache__/
*.pyc

# Transient answer file bmad setup writes and deletes
.bmad-help-setup-modules.toml

# bmad-build's rendered workflow snapshots (regenerated on every run)
_bmad/render/

# Personal BMad overrides are ignored by _bmad/custom/.gitignore (*.user.toml)

# JS build pipeline (@wordpress/scripts): dependencies and built assets stay
# out of git — CI builds them and ships the artifact.
node_modules/
post-quality-manager/admin/build/

# Local plugin zips written by `npm run zip` (bin/zip.js)
/dist/

# Personal agent notes (Headroom `headroom learn` default target, ADR 0007);
# accepted findings are folded into memory/lessons.md by hand.
CLAUDE.local.md
