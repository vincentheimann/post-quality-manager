{
  "name": "post-quality-manager",
  "version": "3.13.2",
  "private": true,
  "description": "Build pipeline for the Post Quality Manager admin app (src/ compiles into the shipped plugin subfolder).",
  "scripts": {
    "build": "wp-scripts build index.js meta-box=meta-box/index.js --webpack-src-dir=src --output-path=post-quality-manager/admin/build",
    "start": "wp-scripts start index.js meta-box=meta-box/index.js --webpack-src-dir=src --output-path=post-quality-manager/admin/build",
    "lint:js": "wp-scripts lint-js src tests/js",
    "test:unit": "wp-scripts test-unit-jest tests/js",
    "zip": "node bin/zip.js"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@wordpress/babel-preset-default": "8.55.0",
    "@wordpress/eslint-plugin": "^28.1.0",
    "@wordpress/jest-preset-default": "14.2.0",
    "@wordpress/scripts": "^37.1.0",
    "babel-jest": "30.5.0",
    "eslint-plugin-jest": "^29.17.0",
    "jest": "30.5.0",
    "jest-environment-jsdom": "30.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "~6.0.3"
  }
}
