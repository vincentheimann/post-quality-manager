{
  "name": "post-quality-manager",
  "version": "3.11.2",
  "private": true,
  "description": "Build pipeline for the Post Quality Manager admin app (src/ compiles into the shipped plugin subfolder).",
  "scripts": {
    "build": "wp-scripts build --webpack-src-dir=src --output-path=post-quality-manager/admin/build",
    "start": "wp-scripts start --webpack-src-dir=src --output-path=post-quality-manager/admin/build",
    "lint:js": "wp-scripts lint-js src tests/js",
    "test:unit": "wp-scripts test-unit-js tests/js",
    "zip": "node bin/zip.js"
  },
  "devDependencies": {
    "@wordpress/scripts": "^30.7.0",
    "typescript": "~5.3.3"
  }
}
